root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,slnx,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core generated migrations are left exactly as generated (plus reviewed hand edits).
[MopBoss.Server/Data/Migrations/*.cs]
generated_code = true
