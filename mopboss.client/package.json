{
  "name": "mopboss-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:audit": "node scripts/with-audit.mjs dev",
    "build:audit": "node scripts/with-audit.mjs build",
    "content:needed": "vitest run src/content/needed.test.ts -u",
    "build:e2e": "node scripts/build-e2e.mjs",
    "check:build-guard": "node scripts/check-build-guard.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.9",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
