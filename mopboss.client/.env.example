# development (default) | preview | production. A production build refuses to build
# unless NEXT_PUBLIC_QUOTE_API_URL and NEXT_PUBLIC_SITE_URL are https and audit mode is off.
NEXT_PUBLIC_DEPLOY_ENV=development

# Set to 1 to show gold placeholder chips for unconfirmed content (never in production).
NEXT_PUBLIC_CONTENT_AUDIT=0

# The live site address, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where MopBoss.Server runs. Empty outside production = demo mode (nothing is sent).
NEXT_PUBLIC_QUOTE_API_URL=
