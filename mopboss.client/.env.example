# Every `next build` must state its deployment; a missing or invalid value fails the build
# (see src/lib/deployGuard.ts). `next dev` uses the committed .env.development instead.

# development | preview | production   (required, exact lowercase)
NEXT_PUBLIC_DEPLOY_ENV=production

# live (default) | demo. Demo sends nothing and is refused in production, and must not be
# combined with an API URL.
NEXT_PUBLIC_QUOTE_MODE=live

# Where MopBoss.Server runs (required for live).
#   production: https, not a local address
#   preview:    https, or http only for a loopback test API (e.g. http://127.0.0.1:5999)
NEXT_PUBLIC_QUOTE_API_URL=https://api.example.com

# The live site address, used for canonical URLs, the sitemap and social previews.
# Required in production (https, not local).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to 1 to show gold placeholder chips for unconfirmed content (never in production).
NEXT_PUBLIC_CONTENT_AUDIT=0
