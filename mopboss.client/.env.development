# Loaded by `next dev` only (never by `next build`). Committed so local development works
# without setup: the quote form runs as an explicit demo and sends nothing. To try the
# real API locally, create .env.development.local (git-ignored) with
#   NEXT_PUBLIC_QUOTE_MODE=live
#   NEXT_PUBLIC_QUOTE_API_URL=https://localhost:7001
NEXT_PUBLIC_DEPLOY_ENV=development
NEXT_PUBLIC_QUOTE_MODE=demo
NEXT_PUBLIC_CONTENT_AUDIT=0
